#!/bin/bash

# ROCIM 项目构建脚本

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD_SCRIPT="$SCRIPT_DIR/build_ninja.sh"

# 检查构建脚本是否存在
if [ ! -f "$BUILD_SCRIPT" ]; then
    echo "❌ 错误：找不到构建脚本 $BUILD_SCRIPT"
    exit 1
fi

# 根据命令执行相应的操作
case "${1:-build}" in
    "clean"|"c")
        "$BUILD_SCRIPT" --clean
        ;;
    "debug"|"d")
        "$BUILD_SCRIPT" --debug
        ;;
    "release"|"r")
        "$BUILD_SCRIPT" --release
        ;;
    "help"|"h"|"-h"|"--help")
        echo "ROCIM 项目构建脚本"
        echo ""
        echo "用法: $0 [命令]"
        echo ""
        echo "命令:"
        echo "  (无参数)          构建项目（默认 Debug）"
        echo "  clean, c          清理后重新构建"
        echo "  debug, d          Debug 模式构建"
        echo "  release, r        Release 模式构建"
        echo "  help, h           显示帮助"
        echo ""
        echo "环境变量:"
        echo "  CMAKE_BUILD_TYPE  构建类型 (Debug 或 Release)"
        echo ""
        echo "示例:"
        echo "  $0                        # 构建项目 (Debug)"
        echo "  $0 clean                  # 清理后构建"
        echo "  $0 release                # Release 模式"
        echo "  CMAKE_BUILD_TYPE=Release $0  # 通过环境变量指定"
        ;;
    *)
        "$BUILD_SCRIPT"
        ;;
esac
